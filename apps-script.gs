  for (var i = 1; i < data.length; i++) {
    var r = data[i]; var key = String(r[5] || '').trim(); if (!key) continue;
    if (attOrd_(r[10]) >= 1 && r[15] !== 'TEST') hasRealRetake[key + '#' + r[8] + '#' + r[9]] = true;
  }
