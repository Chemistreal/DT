  try { buildSendSheet(); } catch (e) {}                   // 결과 정리 후 문자발송 탭도 자동 갱신
  Logger.log('cleanupPassedRetakes: ' + removed.length + '행 삭제 + 문자발송 갱신\n' + removed.join('\n'));
}

/* ★ 편집기에서 1회 실행: 정시(첫 응시)가 테스트(TEST)로 잘못 저장됐는데 같은 회차에
