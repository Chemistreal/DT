function attDisp_(a) { var k = typeof a === 'number' ? a : attOrd_(a); return k <= 0 ? '정시' : k === 1 ? '재시' : k === 2 ? '재재시' : '재시 ' + k + '차'; }

/* 앱에서 채점 결과 1건 저장 (POST JSON) -------------------------------- */
