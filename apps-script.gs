    year: String(r[7] || ''), survey: String(r[13] || ''), ans: String(r[18] == null ? '' : r[18]).replace(/^'/, ''),
    ms: Number(m.ms) || 0, isTest: String(r[15] || '') === 'TEST', src: String(m.src || 'web') };
