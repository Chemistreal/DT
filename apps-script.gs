      continue;                                            // 삭제 대상: 통과 시도보다 뒤의 재시
    }
    keep.push(r.slice(0, HEADERS.length));
  }
  if (!removed.length) { Logger.log('정리 대상 없음 (통과 후 남은 불필요한 재시가 없습니다)'); return; }
  sh.clearContents();
  sh.getRange(1, 1, keep.length, HEADERS.length).setValues(keep);
