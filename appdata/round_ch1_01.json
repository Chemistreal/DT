{"course": "ch1", "round": 1, "title": "화학1 누적 OX 1회", "scoring": {"per": 1.6667, "max": 100, "wrong": 0, "blank": 0, "pass": 80}, "jeongsi": {"n": 60, "items": [{"n": "1-01", "u": "Ⅰ-1", "mis": "원소·원자·분자 정의", "a": "O", "s": "원소는 물질을 이루는 기본 성분이다.", "f": "원소는 물질을 이루는 기본 성분이다.", "w": "원소는 성분, 원자는 입자, 분자는 성질의 단위로 구분한다.", "lvl": 1, "c": "CH1-001"}, {"n": "1-02", "u": "Ⅰ-1", "mis": "원소·원자·분자 정의", "a": "X", "s": "원자는 물질의 성질을 나타내는 기본 입자이다.", "f": "분자가 물질의 성질을 나타내는 기본 입자이다.", "w": "성질의 단위는 분자, 원자는 물질을 이루는 기본 입자다.", "lvl": 2, "c": "CH1-001"}, {"n": "1-03", "u": "Ⅰ-1", "mis": "분자 종류", "a": "O", "s": "He은 일원자분자이다.", "f": "He은 일원자분자이다.", "w": "비활성 기체는 원자 1개가 분자처럼 행동한다.", "lvl": 1, "c": "CH1-002"}, {"n": "1-04", "u": "Ⅰ-1", "mis": "분자 종류", "a": "X", "s": "HCl은 일원자분자이다.", "f": "HCl은 이원자분자이다.", "w": "H와 Cl 두 원자로 이루어진다.", "lvl": 1, "c": "CH1-002"}, {"n": "1-05", "u": "Ⅰ-1", "mis": "분자 종류", "a": "O", "s": "CO₂는 삼원자분자이다.", "f": "CO₂는 삼원자분자이다.", "w": "C 1개 + O 2개 = 3원자.", "lvl": 1, "c": "CH1-002"}, {"n": "1-06", "u": "Ⅰ-1", "mis": "원소 수 세기", "a": "O", "s": "메테인(CH₄)을 이루는 원소는 2종류이다.", "f": "메테인(CH₄)을 이루는 원소는 2종류이다.", "w": "C와 H 두 종류 원소로 구성.", "lvl": 1, "c": "CH1-003"}, {"n": "1-07", "u": "Ⅰ-1", "mis": "원자 수 세기", "a": "O", "s": "물(H₂O) 한 분자를 이루는 원자 수는 3이다.", "f": "물(H₂O) 한 분자를 이루는 원자 수는 3이다.", "w": "H 2개 + O 1개 = 3원자.", "lvl": 1, "c": "CH1-004"}, {"n": "1-08", "u": "Ⅰ-1", "mis": "원자 수 세기", "a": "X", "s": "포도당(C₆H₁₂O₆) 한 분자를 이루는 원자 수는 12이다.", "f": "포도당(C₆H₁₂O₆) 한 분자를 이루는 원자 수는 24이다.", "w": "6 + 12 + 6 = 24원자.", "lvl": 2, "c": "CH1-004"}, {"n": "1-09", "u": "Ⅰ-1", "mis": "화학식 종류", "a": "O", "s": "실험식은 물질을 이루는 원자나 이온의 종류를 가장 간단한 정수비로 나타낸 화학식이다.", "f": "실험식은 물질을 이루는 원자나 이온의 종류를 가장 간단한 정수비로 나타낸 화학식이다.", "w": "분자식은 실제 개수, 실험식은 가장 간단한 정수비다 — C₆H₁₂O₆의 실험식은 CH₂O.", "lvl": 2, "c": "CH1-005"}, {"n": "1-10", "u": "Ⅰ-1", "mis": "화학식 종류", "a": "X", "s": "시성식은 결합선을 사용하여 분자의 구조를 나타낸 화학식이다.", "f": "시성식은 작용기를 사용하여 분자의 특성을 나타낸 화학식이다.", "w": "결합선으로 구조를 나타낸 것은 구조식이다.", "lvl": 2, "c": "CH1-005"}, {"n": "1-11", "u": "Ⅰ-1", "mis": "실험식 도출", "a": "O", "s": "아세트산(C₂H₄O₂)의 실험식은 CH₂O이다.", "f": "아세트산(C₂H₄O₂)의 실험식은 CH₂O이다.", "w": "각 원자 수를 2로 나눈 가장 간단한 정수비.", "lvl": 2, "c": "CH1-006"}, {"n": "1-12", "u": "Ⅰ-1", "mis": "실험식 도출", "a": "O", "s": "포도당(C₆H₁₂O₆)과 아세트산(CH₃COOH)의 실험식은 같다.", "f": "포도당(C₆H₁₂O₆)과 아세트산(CH₃COOH)의 실험식은 같다.", "w": "둘 다 실험식이 CH₂O.", "lvl": 3, "c": "CH1-006"}, {"n": "1-13", "u": "Ⅰ-1", "mis": "화학식 종류", "a": "X", "s": "NaCl은 분자식이다.", "f": "NaCl은 실험식이다.", "w": "이온결정은 분자 단위가 없어 실험식으로 표현.", "lvl": 2, "c": "CH1-005"}, {"n": "1-14", "u": "Ⅰ-1", "mis": "원자 구조", "a": "O", "s": "원자는 원자핵과 전자로 이루어진다.", "f": "원자는 원자핵과 전자로 이루어진다.", "w": "중심의 원자핵과 그 주위 전자.", "lvl": 1, "c": "CH1-007"}, {"n": "1-15", "u": "Ⅰ-1", "mis": "입자 질량비", "a": "X", "s": "양성자, 중성자, 전자의 질량비는 1:1:1이다.", "f": "양성자, 중성자, 전자의 질량비는 약 1:1:0이다.", "w": "전자 질량은 양성자의 약 1/1840로 무시 수준.", "lvl": 2, "c": "CH1-008"}, {"n": "1-16", "u": "Ⅰ-1", "mis": "입자 전하비", "a": "O", "s": "양성자, 중성자, 전자의 전하량비는 1:0:-1이다.", "f": "양성자, 중성자, 전자의 전하량비는 1:0:-1이다.", "w": "양성자 +1, 중성자 0, 전자 -1.", "lvl": 2, "c": "CH1-009"}, {"n": "1-17", "u": "Ⅰ-1", "mis": "원자 중성", "a": "O", "s": "원자는 전기적으로 중성이다.", "f": "원자는 전기적으로 중성이다.", "w": "양성자수와 전자수가 같아 알짜 전하가 0.", "lvl": 1, "c": "CH1-010"}, {"n": "1-18", "u": "Ⅰ-1", "mis": "원자 중성", "a": "X", "s": "원자에서 양성자수와 중성자수는 항상 같다.", "f": "원자에서 양성자수와 전자수가 같다.", "w": "중성 조건은 양성자수 = 전자수. 중성자수는 원소마다 다르다.", "lvl": 2, "c": "CH1-010"}, {"n": "1-19", "u": "Ⅰ-1", "mis": "원자핵 구성", "a": "O", "s": "원자핵은 양성자와 중성자로 이루어진다.", "f": "원자핵은 양성자와 중성자로 이루어진다.", "w": "전자는 핵 밖에 존재한다.", "lvl": 1, "c": "CH1-007"}, {"n": "1-20", "u": "Ⅰ-1", "mis": "옥텟규칙", "a": "O", "s": "옥텟 규칙은 원자가 가장 바깥 껍질에 전자 8개를 채워 안정해지려는 경향이다.", "f": "옥텟 규칙은 원자가 가장 바깥 껍질에 전자 8개를 채워 안정해지려는 경향이다.", "w": "단 첫 번째 껍질은 2개일 때 안정.", "lvl": 1, "c": "CH1-012"}, {"n": "1-21", "u": "Ⅰ-1", "mis": "옥텟규칙", "a": "X", "s": "칼슘(Ca) 원자는 옥텟 규칙을 만족한다.", "f": "칼슘 이온(Ca²⁺)이 옥텟 규칙을 만족한다.", "w": "Ca 원자는 최외각 2개, 전자 2개를 잃은 Ca²⁺가 옥텟.", "lvl": 2, "c": "CH1-012"}, {"n": "1-22", "u": "Ⅰ-1", "mis": "루이스 전자점식", "a": "O", "s": "루이스 전자점식은 원자가 전자를 점으로 나타낸 식이다.", "f": "루이스 전자점식은 원자가 전자를 점으로 나타낸 식이다.", "w": "원자가 전자를 점으로 표시한다.", "lvl": 1, "c": "CH1-013"}, {"n": "1-23", "u": "Ⅰ-1", "mis": "루이스 전자점식", "a": "O", "s": "루이스 전자점식에서는 원소 기호 둘레에 원자가 전자를 점으로 표시한다.", "f": "루이스 전자점식에서는 원소 기호 둘레에 원자가 전자를 점으로 표시한다.", "w": "원소 기호 상하좌우에 점을 배치.", "lvl": 1, "c": "CH1-013"}, {"n": "1-24", "u": "Ⅰ-1", "mis": "루이스 전자점식", "a": "X", "s": "산소(O) 원자의 루이스 전자점식에는 점이 8개 찍힌다.", "f": "산소(O) 원자의 루이스 전자점식에는 점이 6개 찍힌다.", "w": "산소의 원자가 전자가 6개이기 때문.", "lvl": 2, "c": "CH1-013"}, {"n": "1-25", "u": "Ⅰ-1", "mis": "루이스 전자점식", "a": "O", "s": "비활성 기체를 제외한 비금속 원소는 원자가 전자를 이용하여 다른 원자와 결합한다.", "f": "비활성 기체를 제외한 비금속 원소는 원자가 전자를 이용하여 다른 원자와 결합한다.", "w": "원자가 전자가 공유결합에 참여한다.", "lvl": 2, "c": "CH1-013"}, {"n": "1-26", "u": "Ⅰ-1", "mis": "주기율표 기초", "a": "O", "s": "주기율표에서 주기는 전자껍질 수를 나타낸다.", "f": "주기율표에서 주기는 전자껍질 수를 나타낸다.", "w": "주기 = 전자껍질 수.", "lvl": 1, "c": "CH1-014"}, {"n": "1-27", "u": "Ⅰ-1", "mis": "주기율표 기초", "a": "O", "s": "주기율표에서 같은 족 원소는 원자가 전자 수가 같다.", "f": "주기율표에서 같은 족 원소는 원자가 전자 수가 같다.", "w": "같은 족은 화학적 성질이 비슷하다.", "lvl": 1, "c": "CH1-014"}, {"n": "1-28", "u": "Ⅰ-1", "mis": "족 판정", "a": "X", "s": "산소(O)는 6족 원소이다.", "f": "산소(O)는 16족 원소이다.", "w": "산소는 원자가 전자 6개, 16족.", "lvl": 1, "c": "CH1-015"}, {"n": "1-29", "u": "Ⅰ-1", "mis": "족 판정", "a": "O", "s": "18족 원소는 비활성 기체이다.", "f": "18족 원소는 비활성 기체이다.", "w": "18족은 안정한 전자 배치를 가진다.", "lvl": 1, "c": "CH1-015"}, {"n": "1-30", "u": "Ⅰ-1", "mis": "이온형성 방향", "a": "O", "s": "금속이 안정한 이온이 될 때 전자를 잃는다.", "f": "금속이 안정한 이온이 될 때 전자를 잃는다.", "w": "금속은 원자가 전자를 잃고 양이온이 된다.", "lvl": 1, "c": "CH1-016"}, {"n": "1-31", "u": "Ⅰ-1", "mis": "이온형성 방향", "a": "O", "s": "비금속이 안정한 이온이 될 때 전자를 얻는다.", "f": "비금속이 안정한 이온이 될 때 전자를 얻는다.", "w": "비금속은 전자를 얻어 음이온이 된다.", "lvl": 1, "c": "CH1-016"}, {"n": "1-32", "u": "Ⅰ-1", "mis": "이온 전하", "a": "O", "s": "플루오린(F)이 안정한 이온이 될 때 전하량은 -1이다.", "f": "플루오린(F)이 안정한 이온이 될 때 전하량은 -1이다.", "w": "17족은 전자 1개를 얻어 -1가.", "lvl": 1, "c": "CH1-017"}, {"n": "1-33", "u": "Ⅰ-1", "mis": "이온 전하", "a": "X", "s": "마그네슘(Mg)이 안정한 이온이 될 때 전하량은 +1이다.", "f": "마그네슘(Mg)이 안정한 이온이 될 때 전하량은 +2이다.", "w": "2족은 전자 2개를 잃어 +2가.", "lvl": 1, "c": "CH1-017"}, {"n": "1-34", "u": "Ⅰ-1", "mis": "결합 기초", "a": "O", "s": "금속과 비금속이 결합하면 이온결합이 형성된다.", "f": "금속과 비금속이 결합하면 이온결합이 형성된다.", "w": "양이온과 음이온의 정전기적 인력.", "lvl": 1, "c": "CH1-018"}, {"n": "1-35", "u": "Ⅰ-1", "mis": "결합 기초", "a": "O", "s": "비금속끼리 결합하면 공유결합이 형성된다.", "f": "비금속끼리 결합하면 공유결합이 형성된다.", "w": "전자쌍을 공유하는 결합.", "lvl": 1, "c": "CH1-018"}, {"n": "1-36", "u": "Ⅰ-1", "mis": "결합 기초", "a": "X", "s": "같은 금속끼리 결합하면 공유결합이 형성된다.", "f": "같은 금속끼리 결합하면 금속결합이 형성된다.", "w": "금속+금속은 자유전자에 의한 금속결합.", "lvl": 2, "c": "CH1-018"}, {"n": "1-37", "u": "Ⅰ-1", "mis": "물질 분류", "a": "O", "s": "순물질은 한 종류의 물질로 이루어진다.", "f": "순물질은 한 종류의 물질로 이루어진다.", "w": "순물질은 물리적 방법으로 분리되지 않는다.", "lvl": 1, "c": "CH1-019"}, {"n": "1-38", "u": "Ⅰ-1", "mis": "물질 분류", "a": "O", "s": "두 종류 이상의 원소가 화학결합하여 만들어진 순물질은 화합물이다.", "f": "두 종류 이상의 원소가 화학결합하여 만들어진 순물질은 화합물이다.", "w": "화합물은 화학적으로 분해 가능한 순물질.", "lvl": 1, "c": "CH1-019"}, {"n": "1-39", "u": "Ⅰ-1", "mis": "순물질·혼합물 경계", "a": "X", "s": "두 종류 이상의 물질이 섞여 있는 것은 화합물이다.", "f": "두 종류 이상의 물질이 섞여 있는 것은 혼합물이다.", "w": "섞임은 혼합물, 화합물은 원소가 화학결합한 순물질.", "lvl": 2, "c": "CH1-020"}, {"n": "1-40", "u": "Ⅰ-1", "mis": "물질 분류", "a": "O", "s": "한 종류의 원소로 이루어진 순물질은 홑원소물질이다.", "f": "한 종류의 원소로 이루어진 순물질은 홑원소물질이다.", "w": "홑원소물질은 화학적으로 분해되지 않는다.", "lvl": 1, "c": "CH1-019"}, {"n": "1-41", "u": "Ⅰ-1", "mis": "물질 분류 판정", "a": "X", "s": "산소(O₂)는 화합물이다.", "f": "산소(O₂)는 홑원소물질(원소)이다.", "w": "산소 한 종류 원소로만 구성.", "lvl": 2, "c": "CH1-021"}, {"n": "1-42", "u": "Ⅰ-1", "mis": "물질 분류 판정", "a": "O", "s": "NaCl은 화합물이다.", "f": "NaCl은 화합물이다.", "w": "Na와 Cl 두 원소가 결합한 화합물.", "lvl": 1, "c": "CH1-021"}, {"n": "1-43", "u": "Ⅰ-1", "mis": "물리·화학변화", "a": "O", "s": "상태 변화는 화학식이 변하지 않는 물리 변화이다.", "f": "상태 변화는 화학식이 변하지 않는 물리 변화이다.", "w": "입자 종류는 그대로이고 배열만 변한다.", "lvl": 1, "c": "CH1-022"}, {"n": "1-44", "u": "Ⅰ-1", "mis": "물리·화학변화", "a": "X", "s": "연소 반응은 물리 변화이다.", "f": "연소 반응은 화학 변화이다.", "w": "화학식이 변하는 변화.", "lvl": 1, "c": "CH1-022"}, {"n": "1-45", "u": "Ⅰ-1", "mis": "물리·화학적 성질", "a": "X", "s": "산성과 염기성은 물리적 성질이다.", "f": "산성과 염기성은 화학적 성질이다.", "w": "반응성과 관련된 화학적 성질.", "lvl": 2, "c": "CH1-023"}, {"n": "1-46", "u": "Ⅰ-1", "mis": "분자 판정", "a": "X", "s": "Fe₂O₃는 5원자 분자이다.", "f": "Fe₂O₃는 분자가 아니다.", "w": "이온결합물질은 분자 단위가 없고 실험식으로 표현.", "lvl": 2, "c": "CH1-024"}, {"n": "1-47", "u": "Ⅰ-1", "mis": "결합 기초", "a": "O", "s": "이온결합은 양이온과 음이온의 정전기적 인력으로 형성된다.", "f": "이온결합은 양이온과 음이온의 정전기적 인력으로 형성된다.", "w": "반대 전하 이온 사이의 쿨롱 인력.", "lvl": 2, "c": "CH1-018"}, {"n": "1-48", "u": "Ⅰ-1", "mis": "물질 상태", "a": "O", "s": "현재 온도가 녹는점보다 높고 끓는점보다 낮으면 그 물질은 액체이다.", "f": "현재 온도가 녹는점보다 높고 끓는점보다 낮으면 그 물질은 액체이다.", "w": "녹는점과 끓는점 사이가 액체 구간.", "lvl": 2, "c": "CH1-025"}, {"n": "1-49", "u": "Ⅰ-2", "mis": "불의 이용", "a": "O", "s": "토기의 제작은 불의 이용으로 가능해졌다.", "f": "토기의 제작은 불의 이용으로 가능해졌다.", "w": "불로 흙을 구워 토기를 만들어 식량을 저장.", "lvl": 1, "c": "CH1-026"}, {"n": "1-50", "u": "Ⅰ-2", "mis": "금속 반응성·사용시기", "a": "X", "s": "금속의 사용 시기는 반응성이 클수록 빨랐다.", "f": "금속의 사용 시기는 반응성이 작을수록 빨랐다.", "w": "반응성이 작을수록 제련이 쉬워 먼저 사용. Cu→Fe→Al.", "lvl": 2, "c": "CH1-027"}, {"n": "1-51", "u": "Ⅰ-2", "mis": "금속 사용시기", "a": "X", "s": "철은 구리보다 사용 시기가 빨랐다.", "f": "구리가 철보다 사용 시기가 빨랐다.", "w": "반응성이 작은 구리(청동기)가 철(철기)보다 먼저.", "lvl": 2, "c": "CH1-028"}, {"n": "1-52", "u": "Ⅰ-2", "mis": "지각 구성원소", "a": "O", "s": "지각을 구성하는 원소 중 질량비가 가장 큰 것은 산소이다.", "f": "지각을 구성하는 원소 중 질량비가 가장 큰 것은 산소이다.", "w": "O > Si > Al > Fe 순.", "lvl": 1, "c": "CH1-029"}, {"n": "1-53", "u": "Ⅰ-2", "mis": "지각 구성원소", "a": "X", "s": "지각 구성원소의 질량비 순서는 규소 > 산소 > 알루미늄 > 철이다.", "f": "지각 구성원소의 질량비 순서는 산소 > 규소 > 알루미늄 > 철이다.", "w": "산소가 1위, 규소가 2위.", "lvl": 2, "c": "CH1-029"}, {"n": "1-54", "u": "Ⅰ-2", "mis": "인체 구성원소", "a": "X", "s": "사람의 몸을 구성하는 원소 중 개수비가 가장 큰 것은 산소이다.", "f": "사람의 몸을 구성하는 원소 중 개수비가 가장 큰 것은 수소이다.", "w": "개수비 H > O > C, 질량비라야 산소가 1위.", "lvl": 2, "c": "CH1-030"}, {"n": "1-55", "u": "Ⅰ-2", "mis": "인체 구성원소", "a": "O", "s": "사람의 몸을 구성하는 원소 중 질량비가 가장 큰 것은 산소이다.", "f": "사람의 몸을 구성하는 원소 중 질량비가 가장 큰 것은 산소이다.", "w": "질량비 O > C > H.", "lvl": 2, "c": "CH1-030"}, {"n": "1-56", "u": "Ⅰ-2", "mis": "질소", "a": "O", "s": "질소는 단백질과 DNA를 구성하는 원소이다.", "f": "질소는 단백질과 DNA를 구성하는 원소이다.", "w": "질소는 생체 고분자의 필수 구성원소.", "lvl": 1, "c": "CH1-031"}, {"n": "1-57", "u": "Ⅰ-2", "mis": "질소 안정성", "a": "O", "s": "질소 기체(N₂)는 매우 안정하여 사람이 호흡으로 직접 이용할 수 없다.", "f": "질소 기체(N₂)는 매우 안정하여 사람이 호흡으로 직접 이용할 수 없다.", "w": "N₂의 삼중결합이 매우 안정하다.", "lvl": 2, "c": "CH1-032"}, {"n": "1-58", "u": "Ⅰ-2", "mis": "하버보슈", "a": "O", "s": "하버보슈법에 의한 암모니아 합성은 식량 부족 문제 개선에 기여하였다.", "f": "하버보슈법에 의한 암모니아 합성은 식량 부족 문제 개선에 기여하였다.", "w": "질소 비료의 대량 생산이 가능해졌다.", "lvl": 1, "c": "CH1-033"}, {"n": "1-59", "u": "Ⅰ-2", "mis": "질소", "a": "O", "s": "질소는 식물의 생장에 필요한 영양소이다.", "f": "질소는 식물의 생장에 필요한 영양소이다.", "w": "질소 비료로 작물 생산성을 높인다.", "lvl": 1, "c": "CH1-031"}, {"n": "1-60", "u": "Ⅰ-2", "mis": "하버보슈", "a": "X", "s": "암모니아(NH₃)는 산소와 수소로 이루어진 화합물이다.", "f": "암모니아(NH₃)는 질소와 수소로 이루어진 화합물이다.", "w": "NH₃는 질소 1개와 수소 3개.", "lvl": 1, "c": "CH1-033"}]}, "retakeC": [{"v": 1, "items": [{"c": "CH1-016", "u": "Ⅰ-1", "a": "O", "s": "비금속이 안정한 이온이 될 때 전자를 얻는다.", "f": "비금속이 안정한 이온이 될 때 전자를 얻는다.", "w": "음이온이 된다."}, {"c": "CH1-024", "u": "Ⅰ-1", "a": "O", "s": "물(H₂O)은 분자이다.", "f": "물(H₂O)은 분자이다.", "w": "공유결합으로 이루어진 분자이다."}, {"c": "CH1-025", "u": "Ⅰ-1", "a": "X", "s": "현재 온도가 녹는점보다 높고 끓는점보다 낮으면 고체이다.", "f": "현재 온도가 녹는점보다 높고 끓는점보다 낮으면 액체이다.", "w": "두 점 사이는 액체이다."}, {"c": "CH1-032", "u": "Ⅰ-2", "a": "O", "s": "질소를 이용하려면 암모니아 등으로 고정해야 한다.", "f": "질소를 이용하려면 암모니아 등으로 고정해야 한다.", "w": "반응성이 작아 형태를 바꿔야 한다."}, {"c": "CH1-024", "u": "Ⅰ-1", "a": "X", "s": "CaCl₂는 분자이다.", "f": "CaCl₂는 분자가 아니라 이온결합 물질이다.", "w": "이온결합 물질이다."}, {"c": "CH1-005", "u": "Ⅰ-1", "a": "O", "s": "분자식은 한 분자를 이루는 원자의 종류와 실제 개수를 나타낸 화학식이다.", "f": "분자식은 한 분자를 이루는 원자의 종류와 실제 개수를 나타낸 화학식이다.", "w": "실제 원자 수를 보여준다."}, {"c": "CH1-008", "u": "Ⅰ-1", "a": "X", "s": "원자의 질량은 전자가 대부분을 차지한다.", "f": "원자의 질량은 대부분 원자핵이 차지한다.", "w": "전자 질량은 무시할 수준이다."}, {"c": "CH